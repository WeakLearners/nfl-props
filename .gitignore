.env
.venv/
__pycache__/
*.pyc

# Rebuildable from nflverse in ~7s.
data/*.db
# SQLite rollback journal. Transient; the checkpoint loop committed it 8 times on 11-03/04.
data/*.db-journal
# Pre-migration safety backups (e.g. decision #39's features.db.bak-2026-09-24)
# -- large, local-only, never a source of truth.
data/*.db.bak-*

# Backtest outputs — regenerable from code + the cached odds below.
reports/*.csv
reports/*.md
reports/*.log
reports/*.err

# Cached odds responses from The Odds API. Kept locally (re-fetching costs real
# quota) but NOT published: this is licensed third-party market data, and
# redistributing it in a public repo is not ours to do.
data/hist/
data/*.parquet
logs/

# Raw sportsbook boards saved by decision #37, one file per fetch -- same
# convention and same reason as data/hist/ above: licensed market data, kept
# locally so a past report's selection logic can be replayed, never published.
data/boards/

# Regenerable model artifacts (scripts/retrain_td_models.py). Metadata is
# tracked; the binary weights are not -- same convention as data/*.parquet.
data/shipping/*.pkl
data/ratings/*.parquet
data/report_state.json
.DS_Store

# Site-wide recommendation marks (server-side state, per machine)
data/marks.json
data/.marks-*.tmp

# NFL team logos: trademarked, fetched locally by scripts/fetch_logos.sh, never committed (repo is public)
static/logos/

# Odds API credit guard runtime files (nflprops/credits.py)
data/credits.json
data/credit_log.csv
data/events_cache.json
