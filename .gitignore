.env
.venv/
__pycache__/
*.pyc

# Rebuildable from nflverse in ~7s.
data/*.db

# Backtest outputs — regenerable from code + the cached odds below.
reports/*.csv
reports/*.md
reports/*.log
reports/*.err

# Cached odds responses from The Odds API. Kept locally (re-fetching costs real
