# nfl-props secrets. Never committed -- see .gitignore.

# The Odds API (https://the-odds-api.com) -- player props require a paid tier.
ODDS_API_KEY=

# Slack incoming webhook for the #nfl-props channel.
SLACK_WEBHOOK_URL=

# Cloudflare Pages publish credentials for scripts/publish_report.py.
# Scope the token to Account -> Cloudflare Pages -> Edit only, on this one
# account. See docs/hosting.md for exactly how to create these.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=nfl-props
